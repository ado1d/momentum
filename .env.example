# ── Database (Neon Postgres) ─────────────────────────────────
# Runtime queries use the POOLED connection (pgbouncer);
# `bun run db:push` / migrations use DIRECT_URL.
# Format:
#   postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Auth (NextAuth v4 + Google OAuth) ───────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-origin>/api/auth/callback/google
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Web push (OPTIONAL — zero-config by default) ───────────
# VAPID keys are auto-generated and stored in the database on first use.
# Only set these to pin a specific keypair (e.g. to reuse one across
# environments). Generate: bunx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"

# ── Cron digest auth (production, optional but recommended) ─
# Any random string. When set on Vercel, the two daily cron slots in
# vercel.json are allowed to deliver the morning digest push while the
# app is closed (Vercel sends it as `Authorization: Bearer <CRON_SECRET>`).
# CRON_SECRET=""
