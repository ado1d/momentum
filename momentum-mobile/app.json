{
  "expo": {
    "name": "Momentum",
    "slug": "momentum",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "momentum",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#10131c",
    "androidStatusBar": {
      "translucent": true
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10131c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momentum.app"
    },
    "android": {
      "package": "com.momentum.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10131c"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2dd4a8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "474ff212-198d-4038-ba89-96f85d8d4275"
      }
    }
  }
}
