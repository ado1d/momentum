// Momentum — Productivity Companion
// Prisma schema (PostgreSQL — hosted on Neon, multi-user via NextAuth Google)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (runtime)
  directUrl = env("DIRECT_URL") // direct connection (migrations / db push)
}

// ─────────────────────────────────────────────────────────────
// Users (Google sign-in via NextAuth, JWT strategy)
// ─────────────────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  todos       Todo[]
  habits      Habit[]
  routines    RoutineTask[]
  notes       Note[]
  journal     JournalEntry[]
  goals       Goal[]
  focusSessions FocusSession[]
  settings    Settings[]
  pushSubscriptions PushSubscription[]
}

// ─────────────────────────────────────────────────────────────
// Tasks (todo list)
// ─────────────────────────────────────────────────────────────
model Todo {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  priority    String     @default("medium") // low | medium | high | urgent
  category    String     @default("personal") // personal | work | learning | health | other
  dueDate     DateTime? // date + optional time
  reminderAt  DateTime?
  repeat      String     @default("none") // none | daily | weekdays | weekly | monthly
  completed   Boolean    @default(false)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  subtasks    Subtask[]

  @@index([userId, completed, dueDate])
}

model Subtask {
  id        String   @id @default(cuid())
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([todoId, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// Habits (daily routine tracker)
// ─────────────────────────────────────────────────────────────
model Habit {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  emoji        String      @default("✅")
  color        String      @default("emerald") // emerald | amber | rose | violet | teal | orange
  timeOfDay    String      @default("anytime") // morning | afternoon | evening | anytime
  reminderTime String? // "08:00"
  targetPerDay Int         @default(1)
  archived     Boolean     @default(false)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  logs         HabitLog[]

  @@index([userId, archived])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD (local day key)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// Routine (structured daily schedule: morning/afternoon/evening)
// ─────────────────────────────────────────────────────────────
model RoutineTask {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  emoji     String       @default("🌅")
  section   String       @default("morning") // morning | afternoon | evening
  time      String? // "07:30"
  days      String       @default("1,2,3,4,5,6,7") // ISO weekdays the task applies to
  archived  Boolean      @default(false)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  logs      RoutineLog[]

  @@index([userId, archived, section])
}

model RoutineLog {
  id     String      @id @default(cuid())
  taskId String
  task   RoutineTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date   String // YYYY-MM-DD

  @@unique([taskId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// Notes (quick capture, markdown)
// ─────────────────────────────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled note")
  content   String   @default("")
  tag       String?
  color     String   @default("default") // default | yellow | green | rose | violet | teal
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, pinned, updatedAt])
}

// ─────────────────────────────────────────────────────────────
// Journal (daily diary)
// ─────────────────────────────────────────────────────────────
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD (unique per user)
  title     String?
  content   String   @default("")
  mood      String? // great | good | okay | low | rough
  energy    Int? // 1..5
  gratitude String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ─────────────────────────────────────────────────────────────
// Goals (daily / weekly / monthly — incl. learning goals)
// ─────────────────────────────────────────────────────────────
model Goal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String   @default("learning") // learning | fitness | career | personal | finance | other
  period      String // daily | weekly | monthly
  target      Int      @default(1) // target units to complete
  progress    Int      @default(0)
  unit        String? // e.g. pages, minutes, sessions
  status      String   @default("active") // active | completed | archived
  startDate   String // YYYY-MM-DD
  endDate     String? // YYYY-MM-DD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status, period])
}

// ─────────────────────────────────────────────────────────────
// Focus sessions (Pomodoro-style deep work timer)
// ─────────────────────────────────────────────────────────────
model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String? // optional linked todo
  label     String? // free-text focus subject
  minutes   Int
  startedAt DateTime
  endedAt   DateTime
  createdAt DateTime @default(now())

  @@index([userId, endedAt])
  @@index([taskId])
}

// ─────────────────────────────────────────────────────────────
// Settings (one row per user)
// ─────────────────────────────────────────────────────────────
model Settings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationsEnabled Boolean  @default(true)
  soundEnabled         Boolean  @default(true)
  weekStartsOn         Int      @default(1) // 0 = Sunday
  defaultView          String   @default("dashboard")
  onboarded            Boolean  @default(false)
  timezone             String? // IANA tz name from the browser, e.g. "Asia/Dhaka"
  lastDigestAt         DateTime? // last morning-digest push sent (dedupe)
  updatedAt            DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Web-push subscriptions (PWA notifications when the app is closed)
// ─────────────────────────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique // push service URL (unique per device/browser)
  p256dh    String // client public key
  auth      String // client auth secret
  userAgent String? // device label for the settings UI
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// App-level key/value store (e.g. auto-generated VAPID keypair for
// web-push — keeps push zero-config: no env vars required)
// ─────────────────────────────────────────────────────────────
model AppConfig {
  key       String   @id
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt
}
