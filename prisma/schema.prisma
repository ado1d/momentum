// Momentum — Productivity Companion
// Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Tasks (todo list)
// ─────────────────────────────────────────────────────────────
model Todo {
  id          String     @id @default(cuid())
  title       String
  notes       String?
  priority    String     @default("medium") // low | medium | high | urgent
  category    String     @default("personal") // personal | work | learning | health | other
  dueDate     DateTime? // date + optional time
  reminderAt  DateTime?
  repeat      String     @default("none") // none | daily | weekdays | weekly | monthly
  completed   Boolean    @default(false)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  subtasks    Subtask[]

  @@index([completed, dueDate])
}

model Subtask {
  id        String   @id @default(cuid())
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([todoId, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// Habits (daily routine tracker)
// ─────────────────────────────────────────────────────────────
model Habit {
  id           String      @id @default(cuid())
  name         String
  emoji        String      @default("✅")
  color        String      @default("emerald") // emerald | amber | rose | violet | teal | orange
  timeOfDay    String      @default("anytime") // morning | afternoon | evening | anytime
  reminderTime String? // "08:00"
  targetPerDay Int         @default(1)
  archived     Boolean     @default(false)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  logs         HabitLog[]

  @@index([archived])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD (local day key)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// Routine (structured daily schedule: morning/afternoon/evening)
// ─────────────────────────────────────────────────────────────
model RoutineTask {
  id        String       @id @default(cuid())
  name      String
  emoji     String       @default("🌅")
  section   String       @default("morning") // morning | afternoon | evening
  time      String? // "07:30"
  days      String       @default("1,2,3,4,5,6,7") // ISO weekdays the task applies to
  archived  Boolean      @default(false)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  logs      RoutineLog[]

  @@index([archived, section])
}

model RoutineLog {
  id     String      @id @default(cuid())
  taskId String
  task   RoutineTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date   String // YYYY-MM-DD

  @@unique([taskId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// Notes (quick capture, markdown)
// ─────────────────────────────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  title     String   @default("Untitled note")
  content   String   @default("")
  tag       String?
  color     String   @default("default") // default | yellow | green | rose | violet | teal
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinned, updatedAt])
}

// ─────────────────────────────────────────────────────────────
// Journal (daily diary)
// ─────────────────────────────────────────────────────────────
model JournalEntry {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  title     String?
  content   String   @default("")
  mood      String? // great | good | okay | low | rough
  energy    Int? // 1..5
  gratitude String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// Goals (daily / weekly / monthly — incl. learning goals)
// ─────────────────────────────────────────────────────────────
model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("learning") // learning | fitness | career | personal | finance | other
  period      String // daily | weekly | monthly
  target      Int      @default(1) // target units to complete
  progress    Int      @default(0)
  unit        String? // e.g. pages, minutes, sessions
  status      String   @default("active") // active | completed | archived
  startDate   String // YYYY-MM-DD
  endDate     String? // YYYY-MM-DD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, period])
}

// ─────────────────────────────────────────────────────────────
// Focus sessions (Pomodoro-style deep work timer)
// ─────────────────────────────────────────────────────────────
model FocusSession {
  id        String   @id @default(cuid())
  taskId    String? // optional linked todo
  label     String? // free-text focus subject
  minutes   Int
  startedAt DateTime
  endedAt   DateTime
  createdAt DateTime @default(now())

  @@index([endedAt])
  @@index([taskId])
}

// ─────────────────────────────────────────────────────────────
// Settings (single-row app settings)
// ─────────────────────────────────────────────────────────────
model Settings {
  id                   String   @id @default("app")
  notificationsEnabled Boolean  @default(true)
  soundEnabled         Boolean  @default(true)
  weekStartsOn         Int      @default(1) // 0 = Sunday
  defaultView          String   @default("dashboard")
  onboarded            Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}
